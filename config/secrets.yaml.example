# ===================================================================
# API Keys & Secrets Configuration (DO NOT COMMIT SENSITIVE VALUES)
# ===================================================================

# LLM Providers (Configure at least one or use Ollama locally)
openai_api_key: "sk-your-openai-api-key-here"
gemini_api_key: "AIzaSy-your-gemini-api-key-here"
anthropic_api_key: "sk-ant-your-anthropic-key-here"
deepseek_api_key: "sk-your-deepseek-api-key-here"
groq_api_key: "gsk_your_groq_api_key_here"
openrouter_api_key: "sk-or-your-openrouter-key-here"

# Local LLM URL (Ollama or vLLM)
ollama_host: "http://localhost:11434"

# LinkedIn Authentication (Optional: only needed if using LinkedIn automated session)
linkedin:
  username: "your_email@example.com"
  password: "your_linkedin_password"
  session_cookie_li_at: "" # Recommended: li_at session cookie avoids 2FA prompts

# Database URL (Defaults to SQLite if left empty)
database_url: "sqlite:///./data/job_hunter.db"
# Example PostgreSQL: "postgresql://postgres:postgres@localhost:5432/job_hunter"
