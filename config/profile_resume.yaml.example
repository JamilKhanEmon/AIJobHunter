# ===================================================================
# Candidate Profile & Resume YAML Schema (Example Template)
# Copy this file to config/profile_resume.yaml and update with your info.
# ===================================================================

personal_information:
  first_name: "Alex"
  last_name: "Rivera"
  headline: "Full-Stack AI Engineer & Distributed Systems Developer"
  email: "candidate@example.com"
  phone_country_code: "+1"
  phone_number: "5551234567"
  city: "San Francisco"
  state_or_region: "California"
  country: "United States"
  postal_code: "94105"
  address: "Downtown, San Francisco"
  github_url: "https://github.com/your-username"
  linkedin_url: "https://www.linkedin.com/in/your-username"
  portfolio_url: "https://yourportfolio.com"

summary: >
  Full-Stack AI Engineer with 5+ years of experience architecting scalable backend APIs,
  multi-agent AI automation pipelines, and high-performance React/Next.js interfaces. Proficient in
  Python, TypeScript, Go, PostgreSQL, Docker, and fine-tuning/deploying local LLMs (Ollama, DeepSeek, Llama).
  Passionate about autonomous agent architectures and intelligent workflow automation.

skills:
  languages:
    - "Python"
    - "TypeScript"
    - "JavaScript"
    - "Go"
    - "SQL"
    - "HTML5/CSS3"
  frameworks_and_backend:
    - "FastAPI"
    - "Django"
    - "Next.js"
    - "React"
    - "Node.js"
    - "TailwindCSS"
  ai_and_data:
    - "LangChain"
    - "LlamaIndex"
    - "Ollama"
    - "DeepSeek / vLLM"
    - "OpenAI / Claude APIs"
    - "ChromaDB / pgvector"
    - "Pandas / NumPy"
  devops_and_tools:
    - "Docker"
    - "Kubernetes"
    - "Git / GitHub Actions"
    - "PostgreSQL"
    - "Redis"
    - "Linux"
    - "Selenium / Playwright"

experience:
  - position: "Senior AI & Full-Stack Engineer"
    company: "TechNexus Global"
    location: "Remote"
    start_date: "2023-01"
    end_date: "Present"
    current: true
    description: >
      Led architecture of autonomous multi-agent systems and real-time backend microservices.
    responsibilities:
      - "Engineered multi-agent LLM routing pipeline reducing model latency by 42% and API costs by 60% using local Ollama fallbacks."
      - "Developed full-stack Next.js and FastAPI enterprise applications serving 50,000+ daily active users."
      - "Automated end-to-end web scraping and data extraction pipelines processing over 2M records weekly."
      - "Mentored 6 junior engineers on microservices architecture, Dockerized deployments, and clean code practices."

education:
  - degree: "Bachelor of Science in Computer Science and Engineering"
    institution: "University of Engineering & Technology"
    graduation_year: "2020"
    gpa: "3.85 / 4.00"

screening_answers:
  legally_authorized_to_work: "Yes"
  requires_visa_sponsorship: "Yes"
  current_notice_period: "2 weeks"
  target_annual_salary_usd: "85000"
  minimum_acceptable_salary_usd: "70000"
  willing_to_relocate: "Yes (with visa sponsorship and relocation support)"
  open_to_remote: "Yes"
  open_to_onsite_in_home_country: "Yes"
  years_of_experience: 5
  english_proficiency: "Fluent / Professional"
  gender_preference: "Decline to self-identify"
  veteran_status: "I am not a protected veteran"
  disability_status: "No, I don't have a disability"
